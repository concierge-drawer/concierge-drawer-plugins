{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "concierge-drawer": {
      "type": "streamable-http",
      "url": "https://mcp.conciergedrawer.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://conciergedrawer.com/oauth/authorize",
            "tokenUrl": "https://conciergedrawer.com/oauth/token",
            "authorizationServerBase": "https://conciergedrawer.com",
            "resource": "https://mcp.conciergedrawer.com/mcp",
            "baseScopes": [
              "organizations:read",
              "vouchers:read",
              "vouchers:write",
              "vouchers:send",
              "members:read",
              "members:write"
            ]
          }
        }
      }
    }
  }
}
